{
  "name": "@codemix/graph-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "The codemix graph database monorepo",
  "keywords": [],
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "_:chk": "pnpm format && pnpm lint:fix && pnpm install && pnpm build && pnpm test:coverage",
    "build": "pnpm run -r build",
    "changeset": "changeset",
    "prepare": "sh ./scripts/setup-git-hooks.sh",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "setup:hooks": "sh ./scripts/setup-git-hooks.sh",
    "typecheck": "pnpm run -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --ignore-pattern '**/grammar.js' .",
    "lint:fix": "pnpm run lint --fix",
    "format": "oxfmt --write '**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,jsonc,yaml,yml,css,scss,html,md,mdx}'",
    "format:check": "oxfmt --check '**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,jsonc,yaml,yml,css,scss,html,md,mdx}'"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@vitest/coverage-istanbul": "catalog:",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
